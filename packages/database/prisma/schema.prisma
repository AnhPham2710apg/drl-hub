datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  CLUB_MANAGER
  FACULTY_OFFICER
  ADMIN
}

enum EventStatus {
  PENDING
  PUBLISHED
  REJECTED
  EXPIRED
}

enum TrackerStatus {
  BOOKMARKED
  REGISTERED
  ATTENDED
  VERIFIED
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(255)
  studentId    String?   @unique @map("student_id") @db.VarChar(20)
  fullName     String    @map("full_name") @db.VarChar(100)
  avatarUrl    String?   @map("avatar_url")
  passwordHash String?   @map("password_hash") @db.VarChar(255)
  faculty      String?   @db.VarChar(100)
  role         Role      @default(STUDENT)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  submittedEvents     Event[]                @relation("UserSubmittedEvents")
  trackedEvents       StudentEventTracker[]

  @@map("users")
}

model Organizer {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(150)
  code            String   @unique @db.VarChar(50)
  facebookPageUrl String?  @map("facebook_page_url")
  logoUrl         String?  @map("logo_url")
  verified        Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  events          Event[]

  @@map("organizers")
}

model DrlCriteria {
  id           Int      @id @default(autoincrement())
  clauseNumber Int      @map("clause_number")
  subClause    String?  @map("sub_clause") @db.VarChar(20)
  title        String   @db.VarChar(255)
  maxPoints    Int      @map("max_points")
  description  String?

  eventMappings EventCriteriaMapping[]

  @@map("drl_criteria")
}

model Event {
  id                   String        @id @default(uuid()) @db.Uuid
  title                String        @db.VarChar(255)
  slug                 String        @unique @db.VarChar(255)
  description          String?
  originalPostUrl      String        @unique @map("original_post_url")
  cleanUrlHash         String        @unique @map("clean_url_hash") @db.VarChar(64)
  posterImageUrl       String?       @map("poster_image_url")
  images               String[]      @default([])
  faculty              String?       @db.VarChar(50)
  campus               String?       @db.VarChar(50)
  format               String?       @db.VarChar(50)
  orgLevel             String?       @map("org_level") @db.VarChar(50)
  organizerId          String?       @map("organizer_id") @db.Uuid
  submittedById        String?       @map("submitted_by") @db.Uuid
  status               EventStatus   @default(PENDING)
  startTime            DateTime?     @map("start_time") @db.Timestamptz
  endTime              DateTime?     @map("end_time") @db.Timestamptz
  registrationDeadline DateTime?     @map("registration_deadline") @db.Timestamptz
  pointsAwarded        Int           @default(0) @map("points_awarded")
  clickCount           Int           @default(0) @map("click_count")
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  organizer            Organizer?    @relation(fields: [organizerId], references: [id], onDelete: SetNull)
  submittedBy          User?         @relation("UserSubmittedEvents", fields: [submittedById], references: [id], onDelete: SetNull)
  criteriaMappings     EventCriteriaMapping[]
  studentTrackers      StudentEventTracker[]

  @@index([status, registrationDeadline], name: "idx_events_status_deadline")
  @@index([cleanUrlHash], name: "idx_events_clean_hash")
  @@map("events")
}

model EventCriteriaMapping {
  eventId       String       @map("event_id") @db.Uuid
  criteriaId    Int          @map("criteria_id")
  awardedPoints Int          @map("awarded_points")

  event         Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  criteria      DrlCriteria  @relation(fields: [criteriaId], references: [id], onDelete: Restrict)

  @@id([eventId, criteriaId])
  @@index([criteriaId], name: "idx_mapping_criteria")
  @@map("event_criteria_mapping")
}

model StudentEventTracker {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  eventId     String        @map("event_id") @db.Uuid
  status      TrackerStatus @default(BOOKMARKED)
  evidenceUrl String?       @map("evidence_url")
  notes       String?
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  event       Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId, status], name: "idx_tracker_user_status")
  @@map("student_event_tracker")
}
